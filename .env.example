# How2Money env template — copy to `.env` at the repo root and fill in real
# values. Nothing here is a working credential, and `.env` is gitignored
# (*.env). Never commit real values.
#
# These are the same three keys the repo's `.env` uses. They are read by
# How2MoneyLoginInfo/database/db_mongo.ts:
#   - database_link        full MongoDB connection string
#   - database_user_name   userinfo override for the link
#   - database_password    userinfo override for the link
#
# MONGO_URI, MONGO_USER, MONGO_PASS, MONGO_DB_NAME and the uppercase
# DATABASE_* names are still accepted by the loader and can live in
# How2MoneyLoginInfo/database/mongo_connection_info.env, but this template only
# mirrors the root `.env`. Server settings (PORT, H2M_DEMO,
# PROTOTYPE_STORAGE_FILE) are read from the process environment.

# ---------------------------------------------------------------------------
# MongoDB — accounts, sessions, dashboard profile, transactions, spend entries
# ---------------------------------------------------------------------------
# Full connection string, e.g.
#   mongodb://localhost:27017
#   mongodb://user:password@localhost:27017
#   mongodb+srv://user:password@cluster.example.mongodb.net/how2money
# Leave it empty to run the dashboard in xlsx demo mode.
database_link=

# Optional userinfo overrides. When both are set they replace whatever user is
# embedded in database_link, and are URL-encoded before being applied.
database_user_name=
database_password=
