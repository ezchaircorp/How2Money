# How2Money environment variables — copy to the paths noted below and fill in
# real values. Nothing here is a working credential.
#
# Where each block is read from:
#   - MongoDB: repo-root .env  OR  How2MoneyLoginInfo/database/mongo_connection_info.env
#     (mongo_connection_info.env wins when both define a key)
#   - Server:  repo-root .env / process environment
#
# All of these files are gitignored (*.env / .env). Never commit real values.

# ---------------------------------------------------------------------------
# MongoDB — accounts, sessions, dashboard profile, transactions, spend entries
# see How2MoneyLoginInfo/database/db_mongo.ts
# ---------------------------------------------------------------------------
# Full connection string. MONGO_URI wins; DATABASE_LINK (the repo-root .env's
# key) is the fallback.
#   mongodb://localhost:27017
#   mongodb://user:password@localhost:27017
#   mongodb+srv://user:password@cluster.example.mongodb.net/how2money
MONGO_URI=
DATABASE_LINK=

# Database name (overrides the path in the URI). When unset the driver uses
# the database name embedded in the URI.
MONGO_DB_NAME=

# Optional userinfo overrides for the URI (URL-encoded when applied). These win
# over whatever userinfo the connection string carries.
MONGO_USER=
MONGO_PASS=
DATABASE_USER_NAME=
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HTTP port (default 3000).
PORT=3000

# Force demo mode: the dashboard reads and writes the xlsx workbook and never
# touches MongoDB. Useful when there is no database at all. Sticky for the
# process lifetime; demo writes are never replayed into Mongo.
H2M_DEMO=

# Workbook used by demo mode (and by the fallback when Mongo is unreachable).
# Defaults to prototype_data_storage.xlsx at the repo root. An explicit path
# is never replaced wholesale by the sample seed.
PROTOTYPE_STORAGE_FILE=
