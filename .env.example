# How2Money env template — copy to `.env` at the repo root and fill in real
# values. Nothing here is a working credential, and `.env` is gitignored
# (*.env). Never commit real values.
#
# These are the same three keys the repo's `.env` uses. They are read by
# How2MoneyLoginInfo/database/db_mongo.ts:
#   - database_link        full MongoDB connection string
#   - database_user_name   userinfo override for the link
#   - database_password    userinfo override for the link
#
# The pair wins per field over whatever the link carries, so filling only the
# password (or only the username) works. MONGO_URI, MONGO_USER, MONGO_PASS,
# MONGO_DB_NAME and the uppercase DATABASE_* names are still accepted, and
# How2MoneyLoginInfo/database/mongo_connection_info.env wins when it defines
# the same key. Server settings (PORT, H2M_DEMO, PROTOTYPE_STORAGE_FILE) are
# read from the process environment.

# ---------------------------------------------------------------------------
# MongoDB — accounts, sessions, dashboard profile, transactions, spend entries
# ---------------------------------------------------------------------------
# Full connection string, e.g.
#   mongodb://localhost:27017
#   mongodb://user:password@localhost:27017
#   mongodb+srv://:@cluster.example.mongodb.net/how2money
#
# A blank username and password in the link is fine — fill in the pair below
# instead. Leave everything empty to run the dashboard in xlsx demo mode.
#
# Heads up: MongoDB cannot connect on client-isolated wifi (most school, campus,
# hotel, and public networks). Those networks reset outbound traffic to port
# 27017 during the TLS handshake, so the log shows ECONNRESET even with a
# correct link. Use a hotspot or local mongod, or set H2M_DEMO=1.
database_link=

# Optional userinfo overrides. When set they replace the matching part of the
# link's userinfo (or fill it in when the link's userinfo is blank), and are
# URL-encoded before being applied. A <db_username> / <db_password> placeholder
# copied from Atlas counts as blank.
database_user_name=
database_password=
