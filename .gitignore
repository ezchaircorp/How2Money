# node_modules is not tracked: dependencies are restored with npm install
# (How2MoneyLoginInfo/start_prototype.sh runs it automatically when missing).
# This also keeps platform-specific native binaries (esbuild, bcrypt) out of
# git, so a clone on any OS installs the right ones.
node_modules/

# Rust build output — no crate in the repo any more, kept so a stray local
# checkout of the deleted budgeting/ engine stays ignored.
target/

# Environments and credentials — nothing in *.env should ever be committed.
# NOTE: How2MoneyLoginInfo/database/connection_info.env was deleted from the
# working tree, but it still exists in git history from before this rule;
# rotating those Postgres credentials is still an owner decision.
.env
*.env

# Local prototype dashboard data (demo mode / Mongo fallback in server.ts)
prototype_data_storage.xlsx
prototype_data_storage.xlsx.*.tmp

# Logs
npm-debug.log*
*.log

# OS junk
.DS_Store
Thumbs.db

# Per-contributor agent files — each contributor keeps their own AGENTS.md
AGENTS.md

# NPMRC acces VERY BAD
.npmrc
